@imc_GENERATED_DISCLAIMER@

#ifndef IMC_CONFIG_IN_H
#define IMC_CONFIG_IN_H

#include <stdint.h>

/// The name of the project
const char *const PROJECT_NAME = "@CMAKE_PROJECT_NAME@";
/// The name of the current version
const char *const VERSION_NAME = "@imc_VERSION_NAME@";
/// The major version number
constexpr int VERSION_MAJOR = @imc_VERSION_MAJOR@;
/// The minor version number
constexpr int VERSION_MINOR = @imc_VERSION_MINOR@;
/// The patch version number
constexpr int VERSION_PATCH = @imc_VERSION_PATCH@;

/// The compiler used for this build
const char *const COMPILER = "@CMAKE_C_COMPILER_ID@";
/// Version of the compiled used for this build
const char *const COMPILER_VERSION = "@CMAKE_C_COMPILER_VERSION@";
/// The build system used for this build
const char *const BUILD_SYSTEM = "@CMAKE_GENERATOR@";
/// The specific toolchain against which the application is built for
const char *const TOOLCHAIN = "@CMAKE_SYSTEM_NAME@";
/// The ultimate os on which the application is built for
const char *const SYSTEM = "@imc_SYSTEM@";

#ifndef DISABLE_BUILD_ID
/// Unique build id
extern const uint8_t BUILD_ID[32];
#endif

#endif //IMC_CONFIG_IN_H
